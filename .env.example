# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
DATABASE_URL=sqlite:///orders.db

# UPI Configuration (Free UPI Payments)
UPI_ID=yourupi@upi  # Your UPI ID (e.g., mobile@upi or name@ybl)
PAYEE_NAME=Your Business Name  # Your business or personal name

# Admin Configuration (Default credentials - CHANGE IN PRODUCTION)
# Default admin user: admin / admin123
# You can change these after first login via the application

# Environment
FLASK_ENV=development

# Logging
LOG_LEVEL=INFO
